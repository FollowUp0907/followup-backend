DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/followup
DB_USERNAME=followup
DB_PASSWORD=YOUR_PASSWORD
# RDS max_connections 한도 내에서 조정
DB_POOL_SIZE=20
CORS_ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=
MAIL_USERNAME=
MAIL_PASSWORD=
APP_ORIGIN=https://followup-frontend-pied.vercel.app
# base64 -w 0 serviceAccountKey.json 명령으로 인코딩한 값 (Firebase 서비스 계정 JSON 전체). 비어 있으면
# Web Push(FCM) 초기화를 건너뛴다 — SSE/폴링에는 영향 없다.
FIREBASE_SERVICE_ACCOUNT_BASE64=
